[Unit]
Description=Llama Qwen2.5-VL-7B Vision (CPU/RAM, RTX 3090 compartida)
After=network.target

[Service]
Type=simple
ExecStart=/home/servidor/llama.cpp/build/bin/llama-server -m /home/servidor/Modelos/Qwen2.5-VL-7B-Instruct-q4_k_m.gguf --mmproj /home/servidor/Modelos/mmproj/Qwen2.5-VL-7B-Instruct-mmproj-bf16.gguf --host 127.0.0.1 --port 8083 -c 128000 --no-mmproj-offload --alias vision-7b
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
