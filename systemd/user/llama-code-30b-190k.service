[Unit]
Description=Llama Code Qwen3-Coder-30B-A3B Q4 150K KV-en-RAM (RTX 3090 + RAM) - ATENCION: la clave se llama coder-30b-190k pero el contexto real es 150000 (bajado desde 190000 el 2026-10-03 por presión de RAM; ver odd/MEMORY.md)
After=network.target

[Service]
Type=simple
ExecStart=/home/servidor/llama.cpp/build/bin/llama-server -m /home/servidor/Modelos/Qwen3-Coder/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf --host 127.0.0.1 --port 8082 -c 150000 --rope-scaling yarn --yarn-orig-ctx 32768 -ctk q4_0 -ctv q4_0 -ngl 99 -np 1 --kv-unified --no-kv-offload --flash-attn on --jinja --chat-template-file %h/Descargas/model-router/templates/qwen3-coder-tools.jinja --alias local-template
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
