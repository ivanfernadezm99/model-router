[Unit]
Description=Llama Qwen3-Coder-30B-A3B Q4 128K (RTX 3090)
After=network.target

[Service]
Type=simple
ExecStart=/home/servidor/llama.cpp/build/bin/llama-server -m /home/servidor/Modelos/Qwen3-Coder/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf -c 128000 -np 1 --ctx-size 128000 --rope-scaling yarn --yarn-orig-ctx 32768 -ctk q4_0 -ctv q4_0 -ngl 99 --kv-unified --flash-attn on --jinja --chat-template-file %h/Descargas/model-router/templates/qwen25-coder-tools.jinja --alias local-template --host 127.0.0.1 --port 8082
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
