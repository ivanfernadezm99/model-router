[Unit]
Description=Model Router Gateway :8000 (FastAPI)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Descargas/model-router
ExecStart=/usr/bin/python3 -m src.gateway.app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
# banderas estables: solo cambiar cuando el operador lo pida explícitamente
Environment=LOOP_GUARD_DISABLED=1
Environment=AUTO_SWITCH_DISABLED=1
# single-node exclusive VRAM — gateway owns lifecycle, backsends stay on 127.0.0.1 only

[Install]
WantedBy=default.target
