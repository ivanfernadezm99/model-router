[Unit]
Description=Model Router Web UI :5000 (Flask)
After=network.target model-router-gateway.service
Wants=model-router-gateway.service

[Service]
Type=simple
WorkingDirectory=%h/Descargas/model-router
ExecStart=/usr/bin/python3 web/app.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PORT=5000
Environment=ROUTER_BASE=http://127.0.0.1:8000

[Install]
WantedBy=default.target
